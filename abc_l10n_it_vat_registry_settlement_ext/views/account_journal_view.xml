<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form_ateco" model="ir.ui.view">
        <field name="name">account.journal.form.ateco</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="l10n_it_vat_registries.view_account_journal_form" />
        <field name="arch" type="xml">
            <field name="tax_registry_id" position="after">
                <field name="ateco_code" />
            </field>
        </field>
    </record>

    <record id="view_account_journal_tree_ateco" model="ir.ui.view">
        <field name="name">account.journal.list.ateco</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree" />
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="ateco_code" optional="show" />
            </field>
        </field>
    </record>
</odoo>
