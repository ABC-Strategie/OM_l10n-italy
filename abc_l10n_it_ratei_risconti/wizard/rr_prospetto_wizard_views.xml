<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rr_prospetto_wizard_form" model="ir.ui.view">
        <field name="name">abc.rr.prospetto.wizard.form</field>
        <field name="model">abc.rr.prospetto.wizard</field>
        <field name="arch" type="xml">
            <form string="Prospetto ratei e risconti">
                <div class="alert alert-info" role="alert" invisible="not selected_count">
                    Verranno considerate solo le <field name="selected_count" class="oe_inline"/> righe selezionate
                    nella lista, con i filtri indicati sotto.
                </div>
                <field name="line_ids" invisible="1"/>
                <field name="available_account_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="output" widget="radio" options="{'horizontal': true}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <label for="date_from" string="Data di chiusura"/>
                        <div class="o_row">
                            <field name="date_from" placeholder="dal"/>
                            <span>al</span>
                            <field name="date_to" placeholder="al"/>
                        </div>
                        <field name="rr_type"/>
                    </group>
                    <group>
                        <field name="only_confirmed"/>
                        <field name="include_excluded"/>
                    </group>
                </group>
                <group>
                    <field name="rr_account_ids" widget="many2many_tags" options="{'no_create': True}"
                           placeholder="Tutti i conti"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Genera" class="btn-primary"/>
                    <button special="cancel" string="Annulla"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
