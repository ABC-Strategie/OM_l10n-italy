<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Elaborazione -->
    <record id="view_rr_run_list" model="ir.ui.view">
        <field name="name">abc.rr.run.list</field>
        <field name="model">abc.rr.run</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="closing_date"/>
                <field name="run_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_rateo_attivo" sum="Totale"/>
                <field name="total_rateo_passivo" sum="Totale"/>
                <field name="total_risconto_attivo" sum="Totale"/>
                <field name="total_risconto_passivo" sum="Totale"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_rr_run_form" model="ir.ui.view">
        <field name="name">abc.rr.run.form</field>
        <field name="model">abc.rr.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Ricalcola" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Conferma e registra" class="btn-primary"
                            invisible="state != 'draft'" groups="account.group_account_manager"
                            confirm="Verranno registrate la scrittura di assestamento alla data D e lo storno al giorno successivo. Procedere?"/>
                    <button name="action_cancel" type="object" string="Annulla elaborazione" invisible="state != 'confirmed'"
                            groups="account.group_account_manager"
                            confirm="Le due scritture verranno annullate e l'elaborazione tornera' in bozza. Procedere?"/>
                    <button name="action_discard" type="object" string="Scarta bozza" invisible="state != 'draft'"/>
                    <button name="action_print" type="object" string="Stampa prospetto"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="changed_count == 0">
                    <field name="changed_count" class="oe_inline"/> righe d'origine sono cambiate dopo la conferma.
                    Creare un'elaborazione integrativa dal menu Elabora per registrare la rettifica.
                </div>
                <div class="alert alert-info mb-0" role="alert" invisible="full_count == 0 or state != 'draft'">
                    <field name="full_count" class="oe_inline"/> ratei coprono il 100% del periodo:
                    verificare se si tratta invece di fatture da ricevere.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book"
                                invisible="not move_id">
                            <span>Scritture</span>
                        </button>
                        <button name="action_view_changed" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="changed_count == 0">
                            <field name="changed_count" widget="statinfo" string="Fonti modificate"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="closing_date"/>
                            <field name="run_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="move_id" invisible="not move_id"/>
                            <field name="reverse_move_id" invisible="not reverse_move_id"/>
                            <field name="confirm_uid" invisible="not confirm_uid"/>
                            <field name="confirm_date" invisible="not confirm_date"/>
                        </group>
                    </group>
                    <group string="Totali">
                        <group>
                            <field name="total_rateo_attivo"/>
                            <field name="total_rateo_passivo"/>
                        </group>
                        <group>
                            <field name="total_risconto_attivo"/>
                            <field name="total_risconto_passivo"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Righe" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0" delete="0"
                                      decoration-muted="excluded" decoration-warning="adjustment" decoration-danger="not rr_account_id and not excluded">
                                    <field name="excluded" widget="boolean_toggle"/>
                                    <field name="rr_type" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="move_id" readonly="1" optional="show"/>
                                    <field name="card_id" readonly="1" optional="hide"/>
                                    <field name="partner_id" readonly="1" optional="show"/>
                                    <field name="account_id" readonly="1"/>
                                    <field name="rr_account_id"/>
                                    <field name="rr_long_account_id" optional="hide"/>
                                    <field name="analytic_precision" column_invisible="True"/>
                                    <field name="analytic_distribution" widget="analytic_distribution"
                                           groups="analytic.group_analytic_accounting" optional="hide"/>
                                    <field name="date_start" readonly="1"/>
                                    <field name="date_end" readonly="1"/>
                                    <field name="days_total" readonly="1" optional="show"/>
                                    <field name="days_rr" readonly="1" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="base_amount" readonly="1" sum="Totale"/>
                                    <field name="calc_amount" optional="hide" sum="Totale"/>
                                    <field name="amount" sum="Totale"/>
                                    <field name="final_within" optional="show" sum="Totale"/>
                                    <field name="final_beyond" optional="show" sum="Totale"/>
                                    <field name="amount_beyond_5y" readonly="1" optional="hide" sum="Totale"/>
                                    <field name="edit_note" optional="show"/>
                                    <field name="adjustment" readonly="1" optional="hide"/>
                                    <field name="full_period" readonly="1" optional="hide"/>
                                    <field name="source_changed" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rr_run_search" model="ir.ui.view">
        <field name="name">abc.rr.run.search</field>
        <field name="model">abc.rr.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="closing_date"/>
                <filter name="draft" string="Bozza" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confermate" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="group_closing" string="Data di chiusura" context="{'group_by': 'closing_date'}"/>
            </search>
        </field>
    </record>

    <record id="action_rr_run" model="ir.actions.act_window">
        <field name="name">Elaborazioni ratei e risconti</field>
        <field name="res_model">abc.rr.run</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_confirmed': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nessuna elaborazione</p>
            <p>Usare il menu "Elabora" per calcolare ratei e risconti alla data di chiusura.</p>
        </field>
    </record>

    <!-- Righe elaborate: analisi -->
    <record id="view_rr_run_line_list" model="ir.ui.view">
        <field name="name">abc.rr.run.line.list</field>
        <field name="model">abc.rr.run.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="excluded" decoration-warning="adjustment">
                <header>
                    <button name="action_prospetto_pdf" type="object" string="PDF"
                            display="always" class="btn-primary"/>
                    <button name="action_prospetto_xlsx" type="object" string="XLSX"
                            display="always" class="btn-secondary"/>
                </header>
                <field name="closing_date"/>
                <field name="run_id"/>
                <field name="run_state" optional="hide"/>
                <field name="rr_type"/>
                <field name="rr_account_id"/>
                <field name="account_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="move_id" optional="show"/>
                <field name="move_date" optional="show"/>
                <field name="card_id" optional="hide"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_total"/>
                <field name="days_competence" optional="show"/>
                <field name="days_rr"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="base_amount" sum="Totale"/>
                <field name="competence_amount" sum="Totale" optional="show"/>
                <field name="amount" sum="Totale"/>
                <field name="final_within" sum="Totale"/>
                <field name="final_beyond" sum="Totale"/>
                <field name="amount_beyond_5y" sum="Totale" optional="show"/>
                <field name="excluded" optional="hide"/>
                <field name="adjustment" optional="hide"/>
                <field name="edit_note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rr_run_line_form" model="ir.ui.view">
        <field name="name">abc.rr.run.line.form</field>
        <field name="model">abc.rr.run.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="run_id"/>
                            <field name="rr_type"/>
                            <field name="name"/>
                            <field name="aml_id"/>
                            <field name="move_id"/>
                            <field name="card_id"/>
                            <field name="partner_id"/>
                            <field name="account_id"/>
                            <field name="rr_account_id"/>
                            <field name="rr_long_account_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="days_total"/>
                            <field name="days_rr"/>
                            <field name="base_amount"/>
                            <field name="calc_amount"/>
                            <field name="amount"/>
                            <field name="final_within"/>
                            <field name="final_beyond"/>
                            <field name="amount_beyond_5y"/>
                            <field name="edit_note"/>
                            <field name="source_changed"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rr_run_line_pivot" model="ir.ui.view">
        <field name="name">abc.rr.run.line.pivot</field>
        <field name="model">abc.rr.run.line</field>
        <field name="arch" type="xml">
            <pivot string="Ratei e risconti">
                <field name="rr_type" type="row"/>
                <field name="rr_account_id" type="row"/>
                <field name="closing_date" type="col" interval="year"/>
                <field name="amount" type="measure"/>
                <field name="final_within" type="measure"/>
                <field name="final_beyond" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_rr_run_line_search" model="ir.ui.view">
        <field name="name">abc.rr.run.line.search</field>
        <field name="model">abc.rr.run.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="rr_account_id"/>
                <field name="move_id"/>
                <field name="closing_date"/>
                <filter name="confirmed" string="Elaborazioni confermate" domain="[('run_state', '=', 'confirmed')]"/>
                <filter name="not_excluded" string="Non escluse" domain="[('excluded', '=', False)]"/>
                <separator/>
                <filter name="ratei" string="Ratei" domain="[('rr_type', 'in', ('rateo_attivo', 'rateo_passivo'))]"/>
                <filter name="risconti" string="Risconti" domain="[('rr_type', 'in', ('risconto_attivo', 'risconto_passivo'))]"/>
                <filter name="beyond" string="Con quota oltre 12 mesi" domain="[('final_beyond', '!=', 0)]"/>
                <separator/>
                <filter name="group_closing" string="Data di chiusura" context="{'group_by': 'closing_date'}"/>
                <filter name="group_type" string="Tipologia" context="{'group_by': 'rr_type'}"/>
                <filter name="group_rr_account" string="Conto rateo/risconto" context="{'group_by': 'rr_account_id'}"/>
                <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_rr_run_line" model="ir.actions.act_window">
        <field name="name">Prospetto ratei e risconti</field>
        <field name="res_model">abc.rr.run.line</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="view_rr_run_line_list"/>
        <field name="search_view_id" ref="view_rr_run_line_search"/>
        <field name="context">{'search_default_confirmed': 1, 'search_default_not_excluded': 1, 'search_default_group_closing': 1, 'search_default_group_type': 1, 'search_default_group_rr_account': 1}</field>
    </record>
</odoo>
