<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rr_account_map_list" model="ir.ui.view">
        <field name="name">abc.rr.account.map.list</field>
        <field name="model">abc.rr.account.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="rr_type"/>
                <field name="source_account_id"/>
                <field name="rr_account_id"/>
                <field name="rr_long_account_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_rr_account_map" model="ir.actions.act_window">
        <field name="name">Eccezioni conti ratei e risconti</field>
        <field name="res_model">abc.rr.account.map</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nessuna eccezione</p>
            <p>Senza eccezioni valgono i conti delle impostazioni. Un'eccezione abbina un conto di costo o ricavo
               a un conto di rateo o risconto diverso, per una tipologia.</p>
        </field>
    </record>
</odoo>
