<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Unico consumatore del provider: elabora la coda nel rispetto
             del throttle. L'intervallo è modificabile da Impostazioni
             tecniche > Azioni pianificate. -->
        <record id="cron_abc_va_process_queue" model="ir.cron">
            <field name="name">Verifica anagrafica: elaborazione coda</field>
            <field name="model_id" ref="model_abc_va_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Alert scadenza client secret: 60, 30, 7 giorni e scaduto -->
        <record id="cron_abc_va_secret_expiry" model="ir.cron">
            <field name="name">Verifica anagrafica: alert scadenza credenziali</field>
            <field name="model_id" ref="model_res_company"/>
            <field name="state">code</field>
            <field name="code">model._cron_abc_va_secret_expiry_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Purge dei log oltre la retention configurata (art. 5 CG AdE) -->
        <record id="cron_abc_va_purge" model="ir.cron">
            <field name="name">Verifica anagrafica: purge log oltre retention</field>
            <field name="model_id" ref="model_abc_va_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
