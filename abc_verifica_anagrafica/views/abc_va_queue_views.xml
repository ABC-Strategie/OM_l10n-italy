<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_abc_va_queue_list" model="ir.ui.view">
        <field name="name">abc.va.queue.list</field>
        <field name="model">abc.va.queue</field>
        <field name="arch" type="xml">
            <list create="0" default_order="create_date desc">
                <field name="create_date" string="Accodata il"/>
                <field name="partner_id"/>
                <field name="value"/>
                <field name="kind" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="attempts"/>
                <field name="next_try" optional="show"/>
                <field name="force" optional="hide"/>
                <field name="last_error" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_abc_va_queue_form" model="ir.ui.view">
        <field name="name">abc.va.queue.form</field>
        <field name="model">abc.va.queue</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_retry" type="object" string="Riprova"
                            class="btn-primary" invisible="state != 'error'"/>
                    <button name="action_cancel" type="object" string="Annulla"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="kind" readonly="1"/>
                            <field name="value" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" string="Accodata il" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="attempts" readonly="1"/>
                            <field name="max_attempts" readonly="1"/>
                            <field name="next_try" readonly="1"/>
                            <field name="force" readonly="state != 'pending'"/>
                            <field name="log_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="last_error" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_abc_va_queue_search" model="ir.ui.view">
        <field name="name">abc.va.queue.search</field>
        <field name="model">abc.va.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="value"/>
                <filter name="filter_pending" string="In attesa" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_error" string="In errore" domain="[('state', '=', 'error')]"/>
                <filter name="filter_done" string="Elaborate" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_force" string="Forzate" domain="[('force', '=', True)]"/>
                <group>
                    <filter name="group_state" string="Stato" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Società" context="{'group_by': 'company_id'}"/>
                    <filter name="group_date" string="Data" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_abc_va_queue" model="ir.actions.act_window">
        <field name="name">Coda verifiche</field>
        <field name="res_model">abc.va.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_abc_va_queue_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nessuna verifica in coda</p>
            <p>Le richieste vengono accodate alla creazione o modifica del codice fiscale di un contatto, oppure con "Verifica ora" sulla sua scheda.</p>
        </field>
    </record>

</odoo>
