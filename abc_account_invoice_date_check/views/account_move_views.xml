<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Il campo serve al popup di conferma (static/src): deve essere nel
         record del form e aggiornarsi con l'onchange al cambio della data. -->
    <record id="view_move_form_inherit_abc_invoice_date_check" model="ir.ui.view">
        <field name="name">account.move.form.inherit.abc.invoice.date.check</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="alerts" position="after">
                <field name="abc_invoice_date_warning" invisible="1"/>
            </field>
        </field>
    </record>

</odoo>
