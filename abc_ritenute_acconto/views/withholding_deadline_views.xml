<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_abc_wh_deadline_list" model="ir.ui.view">
        <field name="name">abc.withholding.deadline.list</field>
        <field name="model">abc.withholding.deadline</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date_due"/>
                <field name="name"/>
                <field name="line_count"/>
                <field name="amount_due"/>
                <field name="reminded_days" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_abc_wh_deadline_form" model="ir.ui.view">
        <field name="name">abc.withholding.deadline.form</field>
        <field name="model">abc.withholding.deadline</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="Quote"/>
                        </button>
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="date_due" readonly="1"/>
                        <field name="amount_due"/>
                        <field name="reminded_days" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_abc_wh_deadline" model="ir.actions.act_window">
        <field name="name">Scadenze e promemoria</field>
        <field name="res_model">abc.withholding.deadline</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
