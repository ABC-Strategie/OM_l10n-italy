<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_abc_wh_payment_list" model="ir.ui.view">
        <field name="name">abc.withholding.payment.list</field>
        <field name="model">abc.withholding.payment</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date"/>
                <field name="period"/>
                <field name="amount_withholding" sum="Totale"/>
                <field name="amount_interest" optional="show" sum="Totale"/>
                <field name="amount_penalty" optional="show" sum="Totale"/>
                <field name="amount_total" sum="Totale"/>
                <field name="amount_compensated" optional="show" sum="Totale"/>
                <field name="amount_to_pay" optional="show" sum="Totale"/>
                <field name="is_late" optional="show"/>
                <field name="missing_receipt" optional="show"/>
                <field name="historical" optional="hide"/>
                <field name="auto" optional="show"/>
                <field name="bank_move_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_abc_wh_payment_form" model="ir.ui.view">
        <field name="name">abc.withholding.payment.form</field>
        <field name="model">abc.withholding.payment</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_compute_tributes" type="object" string="Ricalcola righe F24"
                            invisible="state != 'draft'" groups="abc_ritenute_acconto.group_wh_manager"/>
                    <button name="action_create_f24_move" type="object" string="Registra scrittura F24" class="btn-primary"
                            invisible="state != 'draft' or bank_move_id" groups="account.group_account_user"
                            confirm="Registrare la scrittura dell'F24 (debiti erariali, compensazioni, saldo in banca) e confermare il versamento?"/>
                    <button name="action_confirm" type="object" string="Conferma versamento"
                            invisible="state != 'draft'" groups="abc_ritenute_acconto.group_wh_manager"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel"/>
                    <button name="action_cancel" type="object" string="Annulla"
                            invisible="state == 'cancelled' or auto" groups="abc_ritenute_acconto.group_wh_manager"
                            confirm="Annullare il versamento? Le quote tornano da versare."/>
                    <button name="action_draft" type="object" string="Riporta in bozza"
                            invisible="state != 'cancelled'" groups="abc_ritenute_acconto.group_wh_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="state != 'confirmed' or not missing_receipt">
                        Versamento senza quietanza F24: allegarla appena disponibile.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not is_late">
                        Versamento oltre la scadenza: indicare sanzioni e interessi da ravvedimento nelle righe F24.
                    </div>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="period" readonly="state != 'draft'"/>
                            <field name="bank_move_id" readonly="auto or state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'" invisible="bank_move_id and state != 'draft'"/>
                            <field name="auto" invisible="not auto"/>
                            <field name="historical" invisible="not historical"/>
                        </group>
                        <group>
                            <field name="amount_withholding"/>
                            <field name="amount_interest"/>
                            <field name="amount_penalty"/>
                            <field name="amount_total"/>
                            <field name="amount_compensated"/>
                            <field name="amount_to_pay" class="fw-bold"/>
                            <field name="receipt" filename="receipt_name"/>
                            <field name="receipt_name" invisible="1"/>
                            <field name="missing_receipt" invisible="1"/>
                            <field name="is_late" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Righe F24" name="tributes">
                            <field name="tribute_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="tributo_code" readonly="1"/>
                                    <field name="year" readonly="1"/>
                                    <field name="amount" readonly="1" sum="Totale"/>
                                    <field name="interest" sum="Totale"/>
                                    <field name="penalty" sum="Totale"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Compensazioni" name="compensations">
                            <field name="compensation_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="account_id"/>
                                    <field name="tributo_code"/>
                                    <field name="year"/>
                                    <field name="amount" sum="Totale"/>
                                    <field name="note"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fatture incluse" name="lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="move_id"/>
                                    <field name="payment_date"/>
                                    <field name="period"/>
                                    <field name="date_due"/>
                                    <field name="tributo_code"/>
                                    <field name="amount" sum="Totale"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_abc_wh_payment_search" model="ir.ui.view">
        <field name="name">abc.withholding.payment.search</field>
        <field name="model">abc.withholding.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="period"/>
                <filter name="draft" string="Bozze" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confermati" domain="[('state', '=', 'confirmed')]"/>
                <filter name="missing_receipt" string="Senza quietanza" domain="[('state', '=', 'confirmed'), ('missing_receipt', '=', True)]"/>
                <filter name="late" string="Con ravvedimento" domain="[('is_late', '=', True)]"/>
                <filter name="auto" string="Da riconciliazione bancaria" domain="[('auto', '=', True)]"/>
                <filter name="date" string="Data versamento" date="date"/>
            </search>
        </field>
    </record>

    <record id="action_abc_wh_payment" model="ir.actions.act_window">
        <field name="name">Versamenti F24</field>
        <field name="res_model">abc.withholding.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
