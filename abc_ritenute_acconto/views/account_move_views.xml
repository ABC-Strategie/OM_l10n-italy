<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_abc_wh" model="ir.ui.view">
        <field name="name">account.move.form.abc.withholding</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_abc_withholding" type="object" class="oe_stat_button"
                        icon="fa-percent" invisible="abc_withholding_count == 0"
                        groups="abc_ritenute_acconto.group_wh_user">
                    <field name="abc_withholding_count" widget="statinfo" string="Ritenute"/>
                </button>
            </xpath>
            <!-- Totale lordo e netto a pagare sotto i totali della fattura -->
            <xpath expr="//field[@name='tax_totals']" position="after">
                <div colspan="2" class="text-end" invisible="not abc_wh_amount">
                    <div>Totale documento (lordo): <field name="abc_wh_gross_total" class="oe_inline fw-bold"/></div>
                    <div>Ritenute e contributi: <field name="abc_wh_amount" class="oe_inline"/></div>
                    <div>Netto a pagare: <field name="abc_wh_net_to_pay" class="oe_inline fw-bold"/></div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
