<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_withholding_reminders" model="ir.cron">
        <field name="name">Ritenute: promemoria scadenze di versamento</field>
        <field name="model_id" ref="model_abc_withholding_deadline"/>
        <field name="state">code</field>
        <field name="code">model._cron_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_withholding_cu_check" model="ir.cron">
        <field name="name">Ritenute: controllo CU ricevute dal 17 marzo</field>
        <field name="model_id" ref="model_abc_withholding_cu_received"/>
        <field name="state">code</field>
        <field name="code">model._cron_cu_check()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
