<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_abc_wh_tax_config_wizard_form" model="ir.ui.view">
        <field name="name">abc.withholding.tax.config.wizard.form</field>
        <field name="model">abc.withholding.tax.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Configura imposte ritenuta">
                <div class="alert alert-info" role="alert" invisible="result">
                    Elenca le imposte ritenuta dell'azienda e le prepara per lo schema del modulo: esigibilita'
                    in base alla fattura, ritenuta sul conto del fornitore/cliente, codice tributo, conti
                    erariali riconciliabili. Togliere la spunta "Applica" sulle imposte da lasciare come sono.
                </div>
                <div class="alert alert-warning" role="alert" invisible="result or not open_invoice_count">
                    Ci sono <field name="open_invoice_count" class="oe_inline"/> fatture non ancora pagate con la
                    ritenuta sul conto d'appoggio. Subito dopo questa configurazione lanciare la ricostruzione dello
                    storico con "Riporta sul fornitore/cliente", prima di registrare nuovi pagamenti.
                </div>
                <group invisible="result">
                    <group>
                        <field name="set_exigibility"/>
                        <field name="set_on_partner"/>
                    </group>
                    <group>
                        <field name="set_tributo"/>
                        <field name="set_reconcile"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="1" force_save="1"/>
                    </group>
                </group>
                <field name="line_ids" invisible="result">
                    <list editable="bottom" create="0" delete="0">
                        <field name="apply"/>
                        <field name="tax_id" readonly="1" force_save="1"/>
                        <field name="type_tax_use"/>
                        <field name="withholding_type"/>
                        <field name="reason"/>
                        <field name="amount"/>
                        <field name="tax_exigibility" optional="show"/>
                        <field name="transition_account_id" optional="show"/>
                        <field name="final_account_id"/>
                        <field name="on_partner" optional="hide"/>
                        <field name="current_tributo" optional="hide"/>
                        <field name="proposed_tributo"/>
                        <field name="open_invoice_count" readonly="1" force_save="1" optional="show"/>
                        <field name="warning" readonly="1" force_save="1"/>
                    </list>
                </field>
                <div invisible="result or not template_ids">
                    <separator string="Imposte standard che l'azienda non ha"/>
                    <p class="text-muted">
                        Spuntare "Crea" per quelle che servono; nome, aliquota, causale e codice si possono
                        correggere. Vengono create gia' configurate: esigibilita' in base alla fattura e ritenuta
                        sul conto del fornitore/cliente. Verificare la causale del 4% condominio.
                    </p>
                    <group>
                        <group>
                            <field name="purchase_account_id"/>
                        </group>
                        <group>
                            <field name="sale_account_id"/>
                        </group>
                    </group>
                    <field name="template_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="create_tax"/>
                            <field name="type_tax_use" readonly="1" force_save="1"/>
                            <field name="name"/>
                            <field name="amount"/>
                            <field name="withholding_type"/>
                            <field name="reason"/>
                            <field name="tributo_code"/>
                            <field name="is_final"/>
                        </list>
                    </field>
                </div>
                <field name="result" invisible="not result" readonly="1"/>
                <footer>
                    <button name="action_apply" type="object" string="Applica la configurazione" class="btn-primary"
                            invisible="result"
                            confirm="Aggiornare le imposte ritenuta selezionate? Da fare insieme alla ricostruzione dello storico."/>
                    <button special="cancel" string="Chiudi"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_abc_wh_tax_config_wizard" model="ir.actions.act_window">
        <field name="name">Configura imposte ritenuta</field>
        <field name="res_model">abc.withholding.tax.config.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
