<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_abc_wh_payment_wizard_form" model="ir.ui.view">
        <field name="name">abc.withholding.payment.wizard.form</field>
        <field name="model">abc.withholding.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Prepara versamento F24">
                <group>
                    <group>
                        <field name="period_date"/>
                        <field name="period"/>
                        <field name="payment_date"/>
                    </group>
                    <group>
                        <field name="apply_threshold"/>
                        <field name="include_contributions"/>
                        <field name="period_total"/>
                        <field name="selected_total"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="not threshold_message">
                    <field name="threshold_message" nolabel="1"/>
                </div>
                <separator string="Quote da versare (togliere o aggiungere righe a piacere)"/>
                <field name="line_ids" domain="[('company_id', '=', company_id), ('cycle', '=', 'passive'), ('kind', '=', 'payment'), ('state', '=', 'due'), '|', ('payment_id', '=', False), ('payment_id.state', '=', 'cancelled')]">
                    <list>
                        <field name="partner_id"/>
                        <field name="move_id"/>
                        <field name="payment_date"/>
                        <field name="period"/>
                        <field name="date_due"/>
                        <field name="tributo_code"/>
                        <field name="amount" sum="Totale"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <div invisible="not previous_line_ids">
                    <separator string="Quote di mesi precedenti non ancora versate"/>
                    <p class="text-muted">Si possono includere in questo F24 oppure lasciarle per un versamento a parte (D23).</p>
                    <button name="action_add_previous" type="object" string="Aggiungi tutte al versamento" class="btn-secondary"/>
                    <field name="previous_line_ids" readonly="1">
                        <list>
                            <field name="partner_id"/>
                            <field name="move_id"/>
                            <field name="period"/>
                            <field name="date_due"/>
                            <field name="tributo_code"/>
                            <field name="amount" sum="Totale"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_create" type="object" string="Crea versamento" class="btn-primary"/>
                    <button special="cancel" string="Annulla"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_abc_wh_payment_wizard" model="ir.actions.act_window">
        <field name="name">Prepara versamento F24</field>
        <field name="res_model">abc.withholding.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
