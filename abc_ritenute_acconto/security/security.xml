<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_wh_user" model="res.groups">
        <field name="name">Ritenute: consultazione</field>
        <field name="comment">Consulta registro, scadenzario e report; stampa ed esporta.</field>
    </record>

    <record id="group_wh_manager" model="res.groups">
        <field name="name">Ritenute: responsabile</field>
        <field name="comment">Prepara e conferma versamenti, CU ricevute, scomputi, CU e 770.</field>
        <field name="implied_ids" eval="[(4, ref('group_wh_user'))]"/>
    </record>

    <!-- I contabili vedono il registro; gli amministratori contabili lo gestiscono -->
    <record id="account.group_account_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_wh_user'))]"/>
    </record>
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_wh_manager'))]"/>
    </record>

    <!-- Multi-azienda -->
    <record id="rule_wh_company" model="ir.rule">
        <field name="name">Ritenute: aziende consentite</field>
        <field name="model_id" ref="model_abc_withholding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wh_line_company" model="ir.rule">
        <field name="name">Quote ritenute: aziende consentite</field>
        <field name="model_id" ref="model_abc_withholding_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wh_payment_company" model="ir.rule">
        <field name="name">Versamenti F24: aziende consentite</field>
        <field name="model_id" ref="model_abc_withholding_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wh_deadline_company" model="ir.rule">
        <field name="name">Scadenze ritenute: aziende consentite</field>
        <field name="model_id" ref="model_abc_withholding_deadline"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wh_cu_received_company" model="ir.rule">
        <field name="name">CU ricevute: aziende consentite</field>
        <field name="model_id" ref="model_abc_withholding_cu_received"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wh_credit_company" model="ir.rule">
        <field name="name">Crediti da ritenute: aziende consentite</field>
        <field name="model_id" ref="model_abc_withholding_credit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wh_declaration_company" model="ir.rule">
        <field name="name">CU e 770: aziende consentite</field>
        <field name="model_id" ref="model_abc_withholding_declaration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wh_cu_company" model="ir.rule">
        <field name="name">CU percipienti: aziende consentite</field>
        <field name="model_id" ref="model_abc_withholding_cu"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wh_map_company" model="ir.rule">
        <field name="name">Tabella causali: aziende consentite</field>
        <field name="model_id" ref="model_abc_withholding_tributo_map"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
